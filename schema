-- ---------------------------------------------------------------------
-- EXAMPLE QUERIES
-- ---------------------------------------------------------------------
-- Dashboard (newest first)
--   SELECT * FROM v_item_cards ORDER BY item_date DESC, created_at DESC;
--
-- Search "wallet"
--   SELECT * FROM v_item_cards
--   WHERE to_tsvector('english', item_name || ' ' || description) @@ plainto_tsquery('english','wallet')
--      OR item_name ILIKE '%wallet%' OR description ILIKE '%wallet%';
--
-- Status filter (Lost) + Category filter (Accessories)
--   SELECT * FROM v_item_cards WHERE item_type = 'lost' AND category = 'Accessories';
--
-- Item details
--   SELECT * FROM v_item_cards WHERE item_id = 1;
--
-- Mark as found / resolved
--   UPDATE items SET state = 'resolved', resolved_at = NOW() WHERE item_id = 1;